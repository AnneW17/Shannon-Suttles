# Studio environment. Copy to `.env` and fill in.
# The project ID is printed in your terminal when you first create the project,
# and is always visible at sanity.io/manage
SANITY_STUDIO_PROJECT_ID="your_project_id_here"
SANITY_STUDIO_DATASET="production"

# The public website address, used by the "Preview" button inside the Studio.
SANITY_STUDIO_PREVIEW_URL="http://localhost:4321"
