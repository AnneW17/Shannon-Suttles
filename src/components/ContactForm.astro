---
/**
 * CONTACT FORM
 *
 * This posts to Buttondown, not to a form service. Everyone who writes in is
 * added to the mailing list, and everything they typed — their name, their
 * organisation, what they were writing about, and the message itself — is
 * stored against their record as subscriber metadata. One list, one place to
 * look, nothing kept in two systems that then disagree.
 *
 * Buttondown's own documentation is explicit that this endpoint must be the
 * `action` of a real HTML form and must NOT be called with fetch(), because
 * the visitor sometimes has to follow the response to clear a CAPTCHA or fix
 * a validation error. So: no JavaScript here, and do not add any.
 *
 * Buttondown then emails the person a confirmation link. They are not on the
 * list until they click it — that double step is what keeps the list clean
 * and keeps the ministry out of spam folders. Until they click, they appear
 * in Buttondown as unactivated, with their message intact, so nothing said
 * here is ever lost.
 *
 * The `tag` marks where the person came from, so enquiries can be told apart
 * from people who simply signed up for the writing.
 */

import { SITE, SUBSCRIBE } from '@lib/site';

interface Props {
  /** Overrides the endpoint. Present for testing; leave unset in the site. */
  action?: string;
}

const { action } = Astro.props;

const endpoint =
  action ??
  (SUBSCRIBE.username
    ? `https://buttondown.com/api/emails/embed-subscribe/${SUBSCRIBE.username}`
    : null);

const field =
  'w-full border-0 border-b border-gold-lum/30 bg-transparent px-0 py-3 font-body text-lg ' +
  'text-pearl placeholder:text-lavender/40 focus:border-gold-lum focus:outline-none';

const labelClass = 'block font-ui text-xs uppercase tracking-[0.18em] text-lavender/70 mb-1';
---

{endpoint && (
<form method="post" action={endpoint} target="_blank" class="rise mt-12 max-w-2xl">
  <input type="hidden" name="embed" value="1" />
  <input type="hidden" name="tag" value="website-enquiry" />

  <div class="grid gap-8 sm:grid-cols-2">
    <div>
      <label for="cf-name" class={labelClass}>Full name</label>
      <input
        id="cf-name"
        name="metadata__first_name"
        type="text"
        required
        autocomplete="name"
        class={field}
      />
    </div>

    <div>
      <label for="cf-email" class={labelClass}>Email address</label>
      <input
        id="cf-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        class={field}
      />
    </div>
  </div>

  <div class="mt-8">
    <label for="cf-org" class={labelClass}>
      Church, ministry, or organization
    </label>
    <input
      id="cf-org"
      name="metadata__organization"
      type="text"
      required
      autocomplete="organization"
      class={field}
    />
    <p class="mt-2 font-ui text-xs text-mauve">
      Please enter N/A if you are writing in a personal capacity.
    </p>
  </div>

  {/* Lets the team sort what arrives before opening it, and means a prayer
      request is never mistaken for a booking enquiry. Netlify records the
      selection alongside the message. */}
  <div class="mt-8">
    <label for="cf-subject" class={labelClass}>Nature of enquiry</label>
    <select id="cf-subject" name="metadata__enquiry_type" required class={`${field} cf-select appearance-none`}>
      <option value="" disabled selected>Please select</option>
      <option value="General enquiry">General enquiry</option>
      <option value="Speaking or ministry invitation">Speaking or ministry invitation</option>
      <option value="Prayer request">Prayer request</option>
      <option value="Partnership or collaboration">Partnership or collaboration</option>
      <option value="Media or press">Media or press</option>
    </select>
  </div>

  <div class="mt-8">
    <label for="cf-message" class={labelClass}>Message</label>
    <textarea
      id="cf-message"
      name="metadata__message"
      required
      rows="6"
      class={`${field} resize-y`}></textarea>
  </div>

  {/* CONSENT
      Required, so the form cannot be submitted without it, and the answer is
      stored alongside the message — which is the point of recording consent
      rather than merely displaying a notice. Deliberately written to stand on
      its own: it does not depend on the visitor having read another page. */}
  <div class="mt-10 flex gap-4">
    <input
      id="cf-consent"
      name="metadata__consent"
      type="checkbox"
      required
      value="Agreed via website contact form"
      class="mt-1.5 h-4 w-4 shrink-0 accent-[var(--color-gold-lum)]"
    />
    <label for="cf-consent" class="font-ui text-sm leading-relaxed text-lavender/75">
      I consent to the details above being retained by Firebrand
      Revivalists&trade; in order to respond to this enquiry, and I would like
      to receive Shannon&rsquo;s words and written prayers by email. I may
      unsubscribe at any time.
    </label>
  </div>

  <p class="mt-5 max-w-xl font-ui text-xs leading-relaxed text-mauve">
    You will be sent a confirmation email; please click the link inside it so
    that your message reaches the team and your subscription begins. Your
    details are held privately and are never sold, rented, or disclosed to
    third parties. To request removal at any time, write to{' '}
    <a href={`mailto:${SITE.email}`} class="link-ink text-lilac">{SITE.email}</a>.
  </p>

  <button type="submit" class="btn-ink mt-10">Submit enquiry</button>
</form>
)}

<style>
  /**
   * THE DROPDOWN LIST
   *
   * The closed select is styled by the page, but the open list of options is
   * drawn by the operating system, not by CSS on the page — so it ignored the
   * pale text colour's surroundings and painted white on white, which made
   * every choice invisible.
   *
   * Two things fix it. `color-scheme: dark` tells the browser to draw its own
   * widgets in dark mode, which handles Safari and the arrow. The explicit
   * colours on `option` handle Windows and Firefox, which need to be told.
   * Both are needed; neither is sufficient alone.
   *
   * Hex values rather than var() on purpose: Firefox has long-standing trouble
   * resolving custom properties inside native option rendering, and a failure
   * here is invisible text again.
   */
  .cf-select {
    color-scheme: dark;
    /* Restores the dropdown arrow removed by appearance-none. */
    background-image: linear-gradient(45deg, transparent 50%, #AD97D4 50%),
      linear-gradient(135deg, #AD97D4 50%, transparent 50%);
    background-position:
      calc(100% - 14px) calc(50% + 1px),
      calc(100% - 9px) calc(50% + 1px);
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
    padding-right: 2rem;
  }

  .cf-select option {
    background-color: #050308;
    color: #FBF5F2;
  }

  .cf-select option[disabled] {
    color: #68596D;
  }
</style>
