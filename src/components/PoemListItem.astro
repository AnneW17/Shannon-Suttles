---
import type { PoemCard } from '@lib/sanity/types';
import { formatDate, isoDate, editorialNumber } from '@lib/format';
import { imageUrl, hasImage } from '@lib/sanity/image';

interface Props {
  poem: PoemCard;
  index?: number;
  showImage?: boolean;
}

const { poem, index, showImage = true } = Astro.props;
const image = poem.featureImage;
---

<article class="reveal group border-b border-champagne-200/70">
  <a href={`/poetry/${poem.slug}`} class="grid gap-5 py-9 sm:grid-cols-12 sm:items-baseline sm:gap-8">
    <!-- Editorial number -->
    {
      index !== undefined && (
        <div class="hidden sm:col-span-1 sm:block">
          <span class="label text-gold-600">{editorialNumber(index + 1)}</span>
        </div>
      )
    }

    <!-- Title + excerpt -->
    <div class={index !== undefined ? 'sm:col-span-7' : 'sm:col-span-8'}>
      <h3
        class="font-display text-3xl leading-tight font-light text-ink-900 transition-colors duration-500 group-hover:text-gold-600 sm:text-4xl"
      >
        {poem.title}
      </h3>
      {
        poem.excerpt && (
          <p class="mt-3 max-w-prose font-body text-lg leading-relaxed text-ink-600 italic">
            {poem.excerpt}
          </p>
        )
      }
    </div>

    <!-- Meta -->
    <div class="sm:col-span-2">
      <time datetime={isoDate(poem.publishedAt)} class="label block">
        {formatDate(poem.publishedAt)}
      </time>
      {poem.category && <span class="label label-gold mt-2 block">{poem.category.title}</span>}
    </div>

    <!-- Thumbnail: small, square, quiet. Not a card. -->
    {
      showImage && hasImage(image) && (
        <div class="veil hidden sm:col-span-2 sm:block">
          <img
            src={imageUrl(image, 320, 320)}
            alt={image.alt || ''}
            width="160"
            height="160"
            class="h-24 w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
  </a>
</article>
