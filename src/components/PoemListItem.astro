---
import type { PoemCard } from '@lib/sanity/types';
import { formatDate, isoDate, editorialNumber } from '@lib/format';
import { imageUrl, hasImage } from '@lib/sanity/image';

interface Props {
  poem: PoemCard;
  index?: number;
  showImage?: boolean;
}

const { poem, index, showImage = true } = Astro.props;
const image = poem.featureImage;
---

<article class="reveal group border-t border-gold-lum/20">
  <a href={`/poetry/${poem.slug}`} class="grid gap-4 py-8 sm:grid-cols-12 sm:items-baseline sm:gap-8 lg:py-10">
    <!-- Editorial number -->
    {
      index !== undefined && (
        <div class="hidden sm:col-span-1 sm:block">
          <span class="label label-gold">{editorialNumber(index + 1)}</span>
        </div>
      )
    }

    <!-- Title + excerpt -->
    <div class={index !== undefined ? 'sm:col-span-7' : 'sm:col-span-8'}>
      <h3
        class="font-display text-3xl leading-tight font-normal text-pearl transition-colors duration-700 group-hover:text-gold-lum sm:text-4xl"
      >
        {poem.title}
      </h3>
      {
        poem.excerpt && (
          <p class="mt-3 max-w-prose font-body text-lg leading-relaxed text-lavender/70 italic">
            {poem.excerpt}
          </p>
        )
      }
    </div>

    <!-- Meta -->
    <div class="sm:col-span-2">
      <time datetime={isoDate(poem.publishedAt)} class="label label-quiet block">
        {formatDate(poem.publishedAt)}
      </time>
      {poem.category && <span class="label label-gold mt-2 block">{poem.category.title}</span>}
    </div>

    <!-- Thumbnail: small, square, quiet. Not a card. -->
    {
      showImage && hasImage(image) && (
        <div class="veil hidden sm:col-span-2 sm:block">
          <img
            src={imageUrl(image, 320, 320)}
            alt={image.alt || ''}
            width="160"
            height="160"
            class="h-24 w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
  </a>
</article>
