---
import { SUBSCRIBE } from '@lib/site';

interface Props {
  /** 'dark' sits on obsidian, 'light' on the pearl ground. */
  tone?: 'dark' | 'light';
  heading?: string;
  note?: string;
}

const {
  tone = 'dark',
  heading = 'Receive each word',
  note = 'New words from the Lord and prayers to pray, sent as they are published.',
} = Astro.props;

const dark = tone === 'dark';

/**
 * SUBSCRIBE
 *
 * Posts straight to the email service, so there is no form handler, no
 * database and no subscriber list for anyone here to maintain. The service
 * stores the address, sends the confirmation, and handles unsubscribes —
 * which is what keeps this compliant without Shannon administering anything.
 *
 * Until SUBSCRIBE.username is filled in (see src/lib/site.ts) this renders
 * nothing at all, rather than showing a form that silently fails.
 */
const action = SUBSCRIBE.username
  ? `https://buttondown.com/api/emails/embed-subscribe/${SUBSCRIBE.username}`
  : null;

const labelClass = `block font-ui text-xs uppercase tracking-[0.18em] mb-1 ${
  dark ? 'text-lavender/70' : ''
}`;

const fieldClass = `w-full border-0 border-b bg-transparent px-0 py-3 font-body text-lg focus:outline-none ${
  dark
    ? 'border-gold-lum/30 text-pearl placeholder:text-lavender/40 focus:border-gold-lum'
    : 'border-obsidian/20 text-obsidian placeholder:text-obsidian/35 focus:border-copper'
}`;
---

{
  action && (
    <section class={`relative overflow-hidden ${dark ? 'g-depth' : 'g-pearl'}`}>
      <div class="mx-auto max-w-[96rem] px-7 py-16 sm:px-12 lg:px-20 lg:py-20">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <p class="label rise mb-4" style={dark ? '' : 'color: var(--color-copper)'}>
              {dark ? <span class="label-gold">Stay with the words</span> : 'Stay with the words'}
            </p>
            <h2
              class={`font-display text-[clamp(1.4rem,1.1rem+1.4vw,2.2rem)] leading-tight font-normal rise ${
                dark ? 'text-pearl' : 'text-obsidian'
              }`}
            >
              {heading}
            </h2>
          </div>

          <div class="lg:col-span-6 lg:col-start-7">
            <p
              class={`rise font-body text-lede leading-[1.8] ${dark ? 'text-lavender/75' : ''}`}
              style={dark ? '' : 'color: var(--color-mauve)'}
            >
              {note}
            </p>

            <form class="rise mt-8" action={action} method="post" target="_blank">
              {/* Buttondown expects this on embedded forms. Without it the
                  endpoint treats the post as coming from its own hosted page
                  and the subscriber can land somewhere unexpected. */}
              <input type="hidden" name="embed" value="1" />

              <div class="grid gap-7 sm:grid-cols-2">
                <div>
                  <label for="bd-name" class={labelClass}>Name</label>
                  <input
                    id="bd-name"
                    type="text"
                    name="metadata__first_name"
                    required
                    autocomplete="name"
                    class={fieldClass}
                  />
                </div>

                <div>
                  <label for="bd-email" class={labelClass}>Email address</label>
                  <input
                    id="bd-email"
                    type="email"
                    name="email"
                    required
                    autocomplete="email"
                    class={fieldClass}
                  />
                </div>
              </div>

              {/* Underscores, not hyphens: Buttondown's own docs note that a
                  hyphenated key cannot be referenced when writing an email,
                  because {{ subscriber.metadata.first-name }} is a syntax
                  error in their template language. */}
              <div class="mt-7">
                <label for="bd-org" class={labelClass}>
                  Church, ministry, or organisation
                </label>
                <input
                  id="bd-org"
                  type="text"
                  name="metadata__organisation"
                  autocomplete="organization"
                  class={fieldClass}
                />
                <p
                  class={`mt-2 font-ui text-xs ${dark ? 'text-mauve' : ''}`}
                  style={dark ? '' : 'color: var(--color-pewter)'}
                >
                  Optional. Please enter N/A if you are subscribing personally.
                </p>
              </div>

              <button type="submit" class={`btn-ink mt-9 ${dark ? '' : 'btn-ink-dark'}`}>
                Subscribe
              </button>
            </form>

            {/* Express consent, required before the form will submit. The
                confirmation email the service sends is the second half of
                this: nobody is added to the list without clicking it. */}
            <div class="rise mt-7 flex gap-4">
              <input
                id="bd-consent"
                type="checkbox"
                required
                class="mt-1.5 h-4 w-4 shrink-0"
                style={dark ? 'accent-color: var(--color-gold-lum)' : 'accent-color: var(--color-copper)'}
              />
              <label
                for="bd-consent"
                class={`font-ui text-sm leading-relaxed ${dark ? 'text-lavender/75' : ''}`}
                style={dark ? '' : 'color: var(--color-mauve)'}
              >
                I consent to receiving Shannon&rsquo;s words and written prayers
                by email, and understand I may unsubscribe at any time.
              </label>
            </div>

            <p
              class={`rise mt-5 font-ui text-xs leading-relaxed ${dark ? 'text-mauve' : ''}`}
              style={dark ? '' : 'color: var(--color-pewter)'}
            >
              Your address is used only to send these writings. It is never
              sold, rented, or disclosed to third parties.
            </p>
          </div>
        </div>
      </div>
    </section>
  )
}
