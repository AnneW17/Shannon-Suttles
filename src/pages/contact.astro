---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactForm from '@components/ContactForm.astro';
import { SITE } from '@lib/site';
---

<BaseLayout title="Contact Shannon&rsquo;s Team" description={`For inquiries and correspondence: ${SITE.email}`}>
  <section class="g-depth relative overflow-hidden">
    <img src="/brand/ink/current.webp" alt="" aria-hidden="true"
      class="ink-art ink-mid drift drift-slow inset-x-0 bottom-[8%] w-full object-cover" />
    <img src="/brand/ink/droplet.webp" alt="" aria-hidden="true"
      class="ink-art ink-far drift drift-rev -right-[10%] top-0 w-[30rem] object-contain lg:right-[2%] lg:w-[38rem]" />

    <div class="above mx-auto max-w-[96rem] px-7 py-20 sm:px-12 lg:px-20 lg:py-28">
      <p class="label label-gold rise mb-9">Contact</p>
      <h1 class="rise">
        <span class="display block text-pearl">Contact</span>
        <span class="display gilt gilt-live block italic">Shannon&rsquo;s Team</span>
      </h1>
      <hr class="rule-fine rule-short rise my-9" />
      <p class="rise max-w-md font-body text-lede leading-[1.9] text-lilac/80">
        For inquiries, speaking requests, or to reach the team.
      </p>

      <ContactForm />

      {/* The address stays. A form can fail in ways a visitor cannot see —
          a network drop, a month at the submission limit — and someone who
          needs to reach the team should never be left with no other way. */}
      <p class="rise mt-14 font-ui text-sm text-mauve" style="--delay:220ms">
        Or write directly:{' '}
        <a href={`mailto:${SITE.email}`} class="link-ink text-lilac">
          {SITE.email}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
