---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactForm from '@components/ContactForm.astro';
import Subscribe from '@components/Subscribe.astro';
import { SITE } from '@lib/site';
---

<BaseLayout title="Contact Shannon&rsquo;s Team" description={`For inquiries and correspondence: ${SITE.email}`}>
  <section class="g-depth relative overflow-hidden">
    <img src="/brand/ink/current.webp" alt="" aria-hidden="true"
      class="ink-art ink-mid drift drift-slow inset-x-0 bottom-[8%] w-full object-cover" />
    <img src="/brand/ink/droplet.webp" alt="" aria-hidden="true"
      class="ink-art ink-far drift drift-rev -right-[10%] top-0 w-[30rem] object-contain lg:right-[2%] lg:w-[38rem]" />

    <div class="above mx-auto max-w-[96rem] px-7 py-20 sm:px-12 lg:px-20 lg:py-28">
      <p class="label label-gold rise mb-9">Contact</p>
      <h1 class="rise">
        <span class="display block text-pearl">Contact</span>
        <span class="display gilt gilt-live block italic">Shannon&rsquo;s Team</span>
      </h1>
      <hr class="rule-fine rule-short rise my-9" />
      <p class="rise max-w-xl font-body text-lede leading-[1.9] text-lilac/80">
        For enquiries, ministry and speaking invitations, prayer requests, and
        all correspondence with Shannon&rsquo;s team.
      </p>

      {/* Two doors, and the smaller one is offered first. Most people arriving
          here want the writing, not a conversation — and asking them to scroll
          past a six-field enquiry form to find a single email box loses them.
          The enquiry form follows for those who actually came to write. */}
      <p class="rise mt-14 max-w-xl font-ui text-sm leading-relaxed text-lavender/70">
        Only here for the writing?{' '}
        <a href="#subscribe" class="link-ink text-lilac">
          Sign up for the free newsletter
        </a>{' '}
        &mdash; it takes one field and no message.
      </p>

      <ContactForm />

      {/* The address stays. A form can fail in ways a visitor cannot see —
          a network drop, a month at the submission limit — and someone who
          needs to reach the team should never be left with no other way. */}
      <p class="rise mt-14 font-ui text-sm text-mauve" style="--delay:220ms">
        You may also write to the team directly at{' '}
        <a href={`mailto:${SITE.email}`} class="link-ink text-lilac">
          {SITE.email}
        </a>
      </p>
    </div>
  </section>

  {/* Signing up and writing in are separate acts, and they stay separate
      forms. Someone who asks a question has not asked to be emailed, and
      quietly adding them is how a ministry ends up marked as spam. So the
      newsletter gets its own plainly-labelled box on this page instead. */}
  <Subscribe
    heading="Sign up for the free newsletter"
    note="Shannon's words from the Lord and written prayers to pray, sent to your inbox as they are published. There is no charge, and you may leave at any time."
  />
</BaseLayout>
