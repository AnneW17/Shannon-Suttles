---
import BaseLayout from '@layouts/BaseLayout.astro';
import PoemBody from '@components/PoemBody.astro';
import { getFeaturedPoem, getRecentPoems } from '@lib/sanity/queries';
import { ORGANISATIONS, SITE } from '@lib/site';
import { formatDate, isoDate, editorialNumber } from '@lib/format';

const [featured, recent] = await Promise.all([getFeaturedPoem(), getRecentPoems(4)]);
const recentPoems = recent.filter((p) => p._id !== featured?._id).slice(0, 3);

const orgIndex = ORGANISATIONS.filter((o) =>
  ['Sophion Media & Consulting Group', 'Jesus Loves the Little Children Chaplaincy',
   'Generational Legacy Foundation', 'Ember Ridge', 'Firebrand Revivalists',
   'Nehemiah Alliance'].includes(o.name)
);

const orgLines: Record<string, string> = {
  'Sophion Media & Consulting Group': 'Discernment and practical wisdom, bringing organisations clarity and order.',
  'Jesus Loves the Little Children Chaplaincy': 'The presence, love, and wisdom of Jesus, wherever children are hurting.',
  'Generational Legacy Foundation': 'So that money never decides whether a child belongs to a safe and loving family.',
  'Ember Ridge': 'A house that ministers first to the Lord, where weary leaders rest and remember the fire.',
  'Firebrand Revivalists': 'Igniting hearts, awakening destiny, reviving glory.',
  'Nehemiah Alliance': 'The 52-Day National Rebuild Initiative. Rebuild, restore, renew.',
};
---

<BaseLayout description={SITE.description}>

  <!-- ═══════════════════════════════════════════════════════════════════
       I. OVERTURE
       Obsidian. Her name set in Bodoni at full width with air around it,
       the portrait offset and cropped as editorial rather than a headshot,
       roses falling down both margins at three depths.
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="ground-obsidian-graded relative overflow-hidden">

    <!-- Roses fall down both margins at four depths and three drift rates.
         Real photography, graded so the blooms emerge out of the black. -->
    <img src="/brand/art/rose-champagne-a-dark.webp" alt="" aria-hidden="true"
      class="rose rose-near parallax parallax-slow -left-24 -top-16 w-[17rem] -rotate-[10deg] sm:w-[22rem] lg:w-[30rem]" />
    <img src="/brand/art/rose-champagne-d-dark.webp" alt="" aria-hidden="true"
      class="rose rose-deep parallax parallax-mid -left-14 top-[42%] w-[11rem] rotate-[16deg] lg:w-[17rem]" />
    <img src="/brand/art/rose-champagne-b-dark.webp" alt="" aria-hidden="true"
      class="rose rose-mid parallax parallax-slow -left-10 bottom-[4%] w-[13rem] -rotate-[6deg] lg:w-[20rem]" />
    <img src="/brand/art/rose-champagne-c-dark.webp" alt="" aria-hidden="true"
      class="rose rose-near parallax parallax-slow -right-24 top-[10%] w-[18rem] rotate-[8deg] sm:w-[23rem] lg:w-[31rem]" />
    <img src="/brand/art/rose-champagne-c-dark.webp" alt="" aria-hidden="true"
      class="rose rose-deep parallax parallax-mid -right-12 top-[52%] w-[12rem] -rotate-[18deg] lg:w-[18rem]" />
    <img src="/brand/art/rose-champagne-e-dark.webp" alt="" aria-hidden="true"
      class="rose rose-mid parallax parallax-slow -right-16 -bottom-10 w-[14rem] rotate-[12deg] lg:w-[21rem]" />
    <!-- Diamonds trickle the margins between the blooms -->
    <img src="/brand/art/diamond-t1-dark.webp" alt="" aria-hidden="true"
      class="rose rose-mid parallax parallax-mid left-[3%] top-[26%] w-[7rem] lg:w-[10rem]" />
    <img src="/brand/art/diamond-t2-dark.webp" alt="" aria-hidden="true"
      class="rose rose-deep parallax parallax-slow right-[5%] top-[38%] w-[6rem] lg:w-[9rem]" />
    <img src="/brand/art/diamond-t3-dark.webp" alt="" aria-hidden="true"
      class="rose rose-mid parallax parallax-mid left-[7%] bottom-[12%] w-[6rem] lg:w-[8rem]" />

    <div class="layer-content mx-auto max-w-[94rem] px-6 pt-16 pb-24 sm:px-10 lg:px-16 lg:pt-24 lg:pb-32">

      <p class="label label-champagne reveal mb-14 lg:mb-20">Poetry · Testimony · Living Legacy</p>

      <!-- The name, given the full measure and nothing to compete with -->
      <h1 class="reveal">
        <span class="wordmark-hero block text-ivory-50">Shannon</span>
        <span class="wordmark-hero block pl-[8vw] text-champagne-300 italic" style="--delay:160ms">Suttles</span>
      </h1>

      <div class="mt-20 grid gap-14 lg:mt-28 lg:grid-cols-12 lg:gap-16">

        <!-- Portrait: tall editorial crop, face held high, never sliced -->
        <div class="lg:col-span-5">
          <figure class="veil-slow photo-frame reveal">
            <img src="/brand/art/portrait-president.webp" alt="Shannon Suttles"
              width="1000" height="1000"
              class="photo photo-portrait aspect-square w-full"
              loading="eager" fetchpriority="high" decoding="async" />
          </figure>
          <p class="label label-muted mt-6" style="color: var(--color-champagne-500)">
            Shannon Suttles · Poet
          </p>
        </div>

        <div class="lg:col-span-6 lg:col-start-7 lg:pt-10">
          <p class="reveal font-body text-[clamp(1.45rem,1.1rem+1.3vw,2.2rem)] leading-[1.5] font-light text-ivory-100">
            This is first and foremost a place where I write poetry to God.
          </p>
          <hr class="rule-hair rule-short reveal my-10" />
          <p class="reveal max-w-md font-body text-lede leading-[1.75] text-champagne-200/80">
            Nothing surrendered to God is wasted. The places that once carried pain can become
            places of refuge. The fire that nearly went out can become warmth for someone still
            finding their way home.
          </p>
          <div class="reveal mt-14 flex flex-wrap gap-5">
            <a href="/poetry" class="btn">Read Shannon&rsquo;s Poetry</a>
            <a href="/about" class="btn" style="border-color: var(--color-ink-700); color: var(--color-champagne-500)">Her Story</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       II. THE JEWEL
       A full-bleed photograph — diamond roses on black satin — bridging the
       overture and the first poem. No type over the subject; the line sits
       in the satin at the foot of the frame.
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="ground-obsidian relative overflow-hidden">
    <!-- The caption sits beneath the plate, not over it. Over a field of
         brilliant-cut stones no scrim keeps type reliably legible, and a
         plate with its line set below reads as a book anyway. -->
    <figure>
      <div class="veil-slow photo-frame">
        <img src="/brand/art/diamond-band.webp" alt="Champagne brilliant-cut diamonds"
          width="776" height="350"
          class="photo w-full object-cover"
          style="height: clamp(16rem, 46vh, 30rem); object-position: 50% 50%;"
          loading="lazy" decoding="async" />
      </div>
      <figcaption class="mx-auto max-w-[94rem] px-6 py-12 sm:px-10 lg:px-16 lg:py-16">
        <p class="reveal max-w-xl font-display text-[clamp(1.35rem,1rem+1.4vw,2.25rem)] leading-[1.4] font-normal text-ivory-50 italic">
          What became wisdom was once a question.
        </p>
        <p class="label label-champagne reveal mt-5">From &ldquo;All of It, Back to You&rdquo;</p>
      </figcaption>
    </figure>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       III. THE FEATURED POEM — ivory paper. The design steps back entirely.
       ═══════════════════════════════════════════════════════════════════ -->
  {featured && (
    <section class="ground-ivory relative overflow-hidden">
      <img src="/brand/art/rose-champagne-d.webp" alt="" aria-hidden="true"
        class="rose parallax parallax-slow -right-20 -top-12 w-[15rem] lg:w-[23rem]" />
      <img src="/brand/art/rose-champagne-e.webp" alt="" aria-hidden="true"
        class="rose parallax parallax-mid -left-16 bottom-16 w-[12rem] lg:w-[18rem]" />

      <div class="layer-content mx-auto max-w-[94rem] px-6 py-24 sm:px-10 lg:px-16 lg:py-40">
        <div class="grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-3">
            <p class="label reveal" style="color: var(--color-champagne-600)">Featured Poem</p>
            <hr class="rule-hair-ivory rule-short reveal mt-6" />
          </div>

          <div class="lg:col-span-7 lg:col-start-5">
            <h2 class="display reveal text-ink-900">{featured.title}</h2>
            <p class="reveal mt-6 flex flex-wrap items-center gap-x-8 gap-y-2">
              <time datetime={isoDate(featured.publishedAt)} class="label" style="color: var(--color-ink-600)">
                {formatDate(featured.publishedAt)}
              </time>
              {featured.category && (
                <span class="label" style="color: var(--color-champagne-600)">{featured.category.title}</span>
              )}
            </p>

            <PoemBody body={featured.body} class="reveal mt-16" />

            <p class="reveal mt-16">
              <a href={`/poetry/${featured.slug}`} class="btn btn-ivory">Read This Poem</a>
            </p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════════════════════════
       III. RECENT — an index set in Bodoni, ruled in champagne hairline
       ═══════════════════════════════════════════════════════════════════ -->
  {recentPoems.length > 0 && (
    <section class="ground-ink relative overflow-hidden">
      <img src="/brand/art/rose-champagne-b-dark.webp" alt="" aria-hidden="true"
        class="rose rose-mid parallax parallax-mid -left-20 bottom-0 w-[14rem] lg:w-[21rem]" />
      <img src="/brand/art/rose-champagne-c-dark.webp" alt="" aria-hidden="true"
        class="rose rose-deep parallax parallax-slow -right-16 top-8 w-[12rem] lg:w-[18rem]" />

      <div class="layer-content mx-auto max-w-[94rem] px-6 py-24 sm:px-10 lg:px-16 lg:py-32">
        <div class="mb-16 flex flex-wrap items-end justify-between gap-8">
          <h2 class="title reveal text-ivory-50">Recent Poems</h2>
          <a href="/poetry" class="label link-editorial label-champagne reveal">All Poetry</a>
        </div>

        <ul class="stagger">
          {recentPoems.map((poem, i) => (
            <li class="reveal" style={`--i:${i}`}>
              <a href={`/poetry/${poem.slug}`}
                class="group grid items-baseline gap-4 border-t border-champagne-600/30 py-9 sm:grid-cols-12 sm:gap-8 lg:py-12">
                <span class="label label-champagne sm:col-span-1">{editorialNumber(i + 1)}</span>
                <h3 class="font-display text-[clamp(1.5rem,1.1rem+1.5vw,2.5rem)] leading-tight font-normal text-ivory-50 transition-colors duration-700 group-hover:text-champagne-300 sm:col-span-6">
                  {poem.title}
                </h3>
                <p class="font-body text-base leading-relaxed text-champagne-200/60 sm:col-span-4">
                  {poem.excerpt}
                </p>
                <time datetime={isoDate(poem.publishedAt)} class="label label-muted sm:col-span-1 sm:justify-self-end"
                  style="color: var(--color-champagne-500)">
                  {formatDate(poem.publishedAt)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════════════════════════
       IV. ONE LIFE, MANY EXPRESSIONS
       Numbered editorial entries. No discs, no cards, no logos in a row.
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="ground-ivory-warm relative overflow-hidden">
    <img src="/brand/art/rose-champagne-a.webp" alt="" aria-hidden="true"
      class="rose parallax parallax-slow -left-20 top-8 w-[15rem] lg:w-[23rem]" />
    <img src="/brand/art/pearl-t2.webp" alt="" aria-hidden="true"
      class="rose parallax parallax-mid -right-14 top-[38%] w-[11rem] lg:w-[17rem]" />
    <img src="/brand/art/rose-champagne-c.webp" alt="" aria-hidden="true"
      class="rose parallax parallax-slow -right-16 bottom-12 w-[13rem] lg:w-[20rem]" />
    <img src="/brand/art/trickle-b.webp" alt="" aria-hidden="true"
      class="rose parallax parallax-mid left-[10%] bottom-[8%] w-[9rem] lg:w-[13rem]" />

    <div class="layer-content mx-auto max-w-[94rem] px-6 py-24 sm:px-10 lg:px-16 lg:py-40">
      <p class="label reveal mb-10" style="color: var(--color-champagne-600)">Beyond the Poetry</p>

      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <h2 class="display reveal text-ink-900">
            One Life,<br /><span class="italic">Many Expressions</span>
          </h2>
        </div>
        <div class="lg:col-span-4 lg:col-start-8 lg:pt-4">
          <p class="reveal font-body text-lede leading-[1.8] text-ink-600">
            None of these began as a portfolio. Each one was born from something I lived through
            with God — restoration, family, prayer, wisdom, and service.
          </p>
        </div>
      </div>

      <ul class="stagger mt-24">
        {orgIndex.map((org, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <a href={org.href} target="_blank" rel="noopener noreferrer"
              class="group grid items-baseline gap-4 border-t border-ink-900/12 py-10 sm:grid-cols-12 sm:gap-8 lg:py-14">
              <span class="label sm:col-span-1" style="color: var(--color-champagne-600)">
                {editorialNumber(i + 1)}
              </span>
              <div class="sm:col-span-6">
                <h3 class="font-display text-[clamp(1.4rem,1.05rem+1.4vw,2.35rem)] leading-[1.15] font-normal text-ink-900 transition-colors duration-700 group-hover:text-champagne-600">
                  {org.name}
                </h3>
                {org.role && (
                  <p class="label mt-4" style="color: var(--color-champagne-600)">{org.role}</p>
                )}
              </div>
              <p class="font-body text-base leading-relaxed text-ink-600 sm:col-span-4">
                {orgLines[org.name]}
              </p>
              <span class="label hidden sm:col-span-1 sm:block sm:justify-self-end"
                style="color: var(--color-champagne-600)">↗</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="reveal mt-16 border-t border-ink-900/12 pt-12">
        <a href="/work" class="btn btn-ivory">Explore Her Work</a>
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       A SECOND PLATE — pearls and diamonds, closing the work section
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="ground-obsidian relative overflow-hidden">
    <figure>
      <div class="veil-slow photo-frame">
        <img src="/brand/art/jewel-pearls.webp" alt="Pearls and diamonds"
          width="1249" height="700"
          class="photo w-full object-cover"
          style="height: clamp(15rem, 40vh, 26rem); object-position: 50% 50%;"
          loading="lazy" decoding="async" />
      </div>
      <figcaption class="mx-auto max-w-[94rem] px-6 py-10 sm:px-10 lg:px-16 lg:py-14">
        <p class="reveal max-w-lg font-display text-[clamp(1.2rem,0.95rem+1.2vw,1.9rem)] leading-[1.4] font-normal text-ivory-50 italic">
          What became shelter was once a wound.
        </p>
      </figcaption>
    </figure>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       V. THE DEDICATION — obsidian, roses close, nothing else
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="ground-obsidian-graded relative overflow-hidden">
    <img src="/brand/art/rose-champagne-a-dark.webp" alt="" aria-hidden="true"
      class="rose rose-feature parallax parallax-slow -left-24 -top-20 w-[19rem] sm:w-[25rem] lg:w-[33rem]" />
    <img src="/brand/art/rose-champagne-c-dark.webp" alt="" aria-hidden="true"
      class="rose rose-near parallax parallax-mid -right-24 -bottom-16 w-[17rem] sm:w-[22rem] lg:w-[30rem]" />
    <img src="/brand/art/rose-champagne-e-dark.webp" alt="" aria-hidden="true"
      class="rose rose-deep parallax parallax-slow -right-10 top-10 w-[11rem] lg:w-[16rem]" />
    <img src="/brand/art/rose-champagne-b-dark.webp" alt="" aria-hidden="true"
      class="rose rose-deep parallax parallax-mid -left-12 bottom-8 w-[12rem] lg:w-[17rem]" />

    <div class="layer-content mx-auto max-w-3xl px-6 py-32 text-center sm:px-10 lg:py-48">
      <p class="label label-champagne reveal">A Dedication</p>
      <hr class="rule-hair rule-short reveal mx-auto mt-8" />

      <div class="reveal mt-16" style="--delay:180ms">
        <p class="font-display text-[clamp(1.5rem,1.1rem+1.7vw,2.5rem)] leading-[1.5] font-normal text-ivory-50">
          Every word gathered here returns to You.
        </p>
        <p class="mt-12 font-body text-[clamp(1.3rem,1rem+1.4vw,2rem)] leading-[1.75] font-light text-champagne-200/85 italic">
          For the breath You gave back to me,<br />
          for the family You gathered from the fragments,<br />
          for every wounded place You taught to shelter another —
        </p>
        <p class="mt-12 font-display text-[clamp(1.5rem,1.1rem+1.7vw,2.5rem)] leading-[1.5] font-normal text-ivory-50">
          Jesus, let these pages be an altar.
        </p>
        <p class="mt-16 font-body text-2xl font-light text-champagne-300 italic">— Shannon</p>
      </div>
    </div>
  </section>

</BaseLayout>
