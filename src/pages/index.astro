---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@lib/site';

// The home page holds no poetry, no biography and no ventures. It exists to
// establish the world and open the four doors into it.
const doors = [
  { label: 'Words & Prayers', href: '/poetry', line: 'Words from the Lord and powerful prayers to declare.' },
  { label: 'About',    href: '/about',   line: 'A life restored, and given back.' },
  { label: 'Ventures', href: '/work',    line: 'A life\u2019s work, built alongside God.' },
  { label: "Contact Shannon's Team", href: '/contact', line: 'For inquiries and correspondence.' },
];
---

<BaseLayout description={SITE.description}>

  <!-- ═══════════════════════════════════════════════════════════════════
       I. THE DESCENT — the signature image, her name, and air
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="g-depth relative min-h-[86vh] overflow-hidden">
    <!-- The sculpture is held far back; the wordmark carries its own burst
         and the two would otherwise fight for the same attention. -->
    <img src="/brand/ink/sculpture.webp" alt="" aria-hidden="true"
      class="ink-art ink-far drift drift-slow -right-[22%] top-0 h-[80vh] w-auto object-contain lg:-right-[8%]" />

    <div class="above mx-auto flex min-h-[86vh] max-w-[96rem] flex-col items-center justify-center px-7 py-24 text-center sm:px-12 lg:px-20">
      <p class="label label-gold rise mb-10 lg:mb-12">Words from the Lord · Written Prayers to Pray</p>

      <!-- The logo, given the full width of the composition and nothing
           placed near it. The heading text is present for screen readers
           and search engines; the image is the visual identity. -->
      <h1 class="rise w-full" style="--delay:200ms">
        <span class="sr-only">Shannon Suttles</span>
        <img src="/brand/ink/wordmark.webp" alt="Shannon Suttles"
          width="1920" height="640"
          class="mx-auto w-full max-w-[64rem] object-contain"
          loading="eager" fetchpriority="high" decoding="async" />
      </h1>

      <p class="rise mt-10 max-w-md font-body text-lede leading-[1.9] text-lilac/80" style="--delay:560ms">
        This is first and foremost a place where I share what the Lord gives me —
        and prayers you can pray.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       II. THE DROP — the moment before language
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="g-obsidian relative overflow-hidden">
    <div class="plate plate-bleed bloom">
      <img src="/brand/ink/droplet.webp" alt="" aria-hidden="true"
        class="mx-auto max-w-[44rem] opacity-90" width="1254" height="1254"
        loading="lazy" decoding="async" />
    </div>
    <div class="above mx-auto -mt-24 max-w-3xl px-7 pb-20 text-center sm:px-12 lg:-mt-28 lg:pb-28">
      <p class="rise font-body text-[clamp(1.3rem,1rem+1.5vw,2.1rem)] leading-[1.7] text-lilac italic">
        Nothing surrendered to God is wasted.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       III. THE CURRENT — the ribbon, carrying you onward
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="g-obsidian relative overflow-hidden">
    <div class="plate plate-bleed bloom">
      <img src="/brand/ink/ribbon.webp" alt="" aria-hidden="true"
        class="h-[clamp(11rem,26vh,18rem)] w-full object-cover" width="1920" height="664"
        loading="lazy" decoding="async" />
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       IV. THE DOORS — navigation as composition, not as a menu
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="g-depth relative overflow-hidden">
    <img src="/brand/ink/quill.webp" alt="" aria-hidden="true"
      class="ink-art ink-mid drift drift-rev -left-[14%] top-[4%] h-[76%] w-auto object-contain lg:-left-[5%]" />

    <div class="above mx-auto max-w-[96rem] px-7 py-20 sm:px-12 lg:px-20 lg:py-28">
      <p class="label label-lilac rise mb-14">Explore</p>
      <ul class="stagger">
        {doors.map((d, i) => (
          <li class="rise" style={`--i:${i}`}>
            <a href={d.href}
              class="group grid items-baseline gap-4 border-t border-gold-lum/20 py-8 sm:grid-cols-12 sm:gap-10 lg:py-11">
              <h2 class="font-display text-[clamp(1.9rem,1.2rem+2.6vw,4rem)] leading-none font-normal text-pearl transition-colors duration-1000 group-hover:text-gold-lum sm:col-span-7">
                {d.label}
              </h2>
              <p class="font-body text-base leading-relaxed text-lavender/60 sm:col-span-4">{d.line}</p>
              <span class="label label-gold hidden sm:col-span-1 sm:block sm:justify-self-end">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       V. THE DEDICATION — the full gradient, once
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="g-liquid relative overflow-hidden">
    <div class="mx-auto max-w-3xl px-7 py-24 text-center sm:px-12 lg:py-32">
      <p class="label rise" style="color: var(--color-mulberry)">A Dedication</p>
      <hr class="rule-ink rule-short rise mx-auto mt-8" />
      <div class="rise mt-12" style="--delay:200ms">
        <p class="font-display text-[clamp(1.5rem,1.1rem+1.8vw,2.6rem)] leading-[1.5] text-pearl">
          Every word gathered here returns to You.
        </p>
        <p class="mt-9 font-body text-[clamp(1.3rem,1rem+1.4vw,2rem)] leading-[1.8] text-obsidian/75 italic">
          For the breath You gave back to me,<br />
          for the family You gathered from the fragments,<br />
          for every wounded place You taught to shelter another —
        </p>
        <p class="mt-9 font-display text-[clamp(1.5rem,1.1rem+1.8vw,2.6rem)] leading-[1.5] text-obsidian">
          Jesus, let these pages be an altar.
        </p>
        <p class="mt-12 font-body text-2xl text-obsidian/70 italic">— Shannon</p>
      </div>
    </div>
  </section>

</BaseLayout>
