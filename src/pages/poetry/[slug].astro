---
import BaseLayout from '@layouts/BaseLayout.astro';
import PoemBody from '@components/PoemBody.astro';
import Signature from '@components/Signature.astro';
import ShareControls from '@components/ShareControls.astro';
import PoemListItem from '@components/PoemListItem.astro';
import {
  getAllPoems,
  getPoemBySlug,
  getRelatedPoems,
  getSiteSettings,
} from '@lib/sanity/queries';
import { imageUrl, imageSrcSet, ogImageUrl, hasImage } from '@lib/sanity/image';
import { poemToPlainText, firstLine } from '@lib/portableText';
import { formatDate, isoDate } from '@lib/format';
import { SITE } from '@lib/site';

// Every published poem becomes a static page at build time.
export async function getStaticPaths() {
  const poems = await getAllPoems();
  return poems.map((poem) => ({ params: { slug: poem.slug } }));
}

const { slug } = Astro.params;
const poem = await getPoemBySlug(slug!);

// getStaticPaths only ever emits slugs that exist, so this is a build-time
// integrity check rather than a runtime branch.
if (!poem) {
  throw new Error(`Poem "${slug}" was in the slug list but could not be fetched.`);
}

const [related, settings] = await Promise.all([
  getRelatedPoems(poem._id, poem.category?.slug),
  getSiteSettings(),
]);

const image = poem.featureImage;
const description =
  poem.seoDescription || poem.excerpt || poemToPlainText(poem.body, 155);
const shareImage = hasImage(image)
  ? ogImageUrl(image)
  : hasImage(settings?.defaultShareImage)
    ? ogImageUrl(settings!.defaultShareImage!)
    : undefined;

// Structured data. Poems are `CreativeWork`, not `BlogPosting` — the
// distinction is small but it is what the work actually is.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': new URL(`/poetry/${poem.slug}`, SITE.url).href,
  name: poem.title,
  headline: poem.title,
  genre: 'Poetry',
  datePublished: poem.publishedAt,
  description,
  inLanguage: 'en',
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Person', name: SITE.name },
  ...(shareImage ? { image: shareImage } : {}),
  ...(poem.tags?.length ? { keywords: poem.tags.join(', ') } : {}),
};
---

<BaseLayout
  title={poem.seoTitle || poem.title}
  description={description}
  image={shareImage}
  type="article"
  publishedTime={poem.publishedAt}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <article>
    <!-- ══════════════════════════════════════════════ TITLE
         No card, no container, no border. The poem is given the page. -->
    <header class="mx-auto max-w-[88rem] px-5 pt-12 sm:px-8 lg:px-12 lg:pt-20">
      <nav aria-label="Breadcrumb" class="mb-12">
        <a href="/poetry" class="label link-editorial">← Poetry</a>
      </nav>

      <div class="grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <h1
            class="reveal font-display text-[clamp(2.25rem,1.3rem+3.6vw,4.75rem)] leading-[1.04] font-light text-ink-900"
          >
            {poem.title}
          </h1>

          <div class="reveal mt-7 flex flex-wrap items-center gap-x-6 gap-y-2">
            <time datetime={isoDate(poem.publishedAt)} class="label">
              {formatDate(poem.publishedAt)}
            </time>
            {poem.category && <span class="label label-gold">{poem.category.title}</span>}
          </div>

          {
            poem.excerpt && (
              <p class="reveal mt-8 max-w-xl font-body text-xl leading-relaxed text-ink-600 italic">
                {poem.excerpt}
              </p>
            )
          }
        </div>
      </div>

      <hr class="rule-gold reveal mt-14" />
    </header>

    <!-- ══════════════════════════════════════════════ IMAGE -->
    {
      hasImage(image) && (
        <figure class="veil mx-auto mt-14 max-w-[88rem] px-5 sm:px-8 lg:px-12">
          <img
            src={imageUrl(image, 1440)}
            srcset={imageSrcSet(image)}
            sizes="(min-width: 1024px) 76rem, 100vw"
            alt={image.alt || ''}
            class="max-h-[70vh] w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          {image.alt && (
            <figcaption class="label mt-4 text-ink-300">{image.alt}</figcaption>
          )}
        </figure>
      )
    }

    <!-- ══════════════════════════════════════════════ THE POEM
         Offset left of centre rather than dead-centred: the eye returns to
         a consistent left margin on every line, which is how poetry is set
         in print and considerably easier to read than centred verse. -->
    <div class="mx-auto max-w-[88rem] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
      <div class="grid lg:grid-cols-12">
        <div class="lg:col-span-7 lg:col-start-3">
          <PoemBody body={poem.body} class="reveal" />

          {poem.showSignature !== false && <Signature settings={settings} />}

          {
            poem.tags && poem.tags.length > 0 && (
              <ul class="mt-14 flex flex-wrap gap-x-5 gap-y-2">
                {poem.tags.map((tag) => (
                  <li class="label">{tag}</li>
                ))}
              </ul>
            )
          }

          <hr class="rule mt-14" />

          <div class="mt-8">
            <ShareControls title={poem.title} url={`/poetry/${poem.slug}`} />
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- ══════════════════════════════════════════════ RELATED -->
  {
    related.length > 0 && (
      <section class="border-t border-champagne-200 bg-cream-50">
        <div class="mx-auto max-w-[88rem] px-5 py-20 sm:px-8 lg:px-12">
          <h2 class="reveal label mb-10">Continue Reading</h2>
          {related.map((item) => (
            <PoemListItem poem={item} showImage={false} />
          ))}
          <p class="mt-12">
            <a href="/poetry" class="label link-editorial text-ink-900">All Poetry</a>
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>
