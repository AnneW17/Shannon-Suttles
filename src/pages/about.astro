---
import BaseLayout from '@layouts/BaseLayout.astro';

const roles = [
  { title: 'President and CEO', org: 'Firebrand Revivalists™' },
  { title: 'President', org: 'Jesus Loves the Little Children Chaplaincy' },
  { title: 'President', org: 'Ember Ridge' },
  { title: 'President', org: 'The Generational Legacy Foundation' },
  { title: 'President and Founder', org: 'Sophion Media & Consulting Group' },
  { title: 'National Leader', org: 'Nehemiah Alliance' },
];
---

<BaseLayout
  title="About Shannon"
  description="Shannon Suttles is an ordained pastor, organisational leader, business strategist, and writer whose life and work have been shaped by restoration."
>

  <!-- ═══ THE PORTRAIT — the only page carrying her photography ═══ -->
  <section class="g-depth relative overflow-hidden">
    <img src="/brand/ink/quill.webp" alt="" aria-hidden="true"
      class="ink-art ink-far drift drift-slow -left-[16%] top-0 h-[76%] w-auto object-contain lg:-left-[7%]" />

    <div class="above mx-auto max-w-[96rem] px-7 pt-20 pb-20 sm:px-12 lg:px-20 lg:pt-24 lg:pb-24">
      <p class="label label-gold rise mb-10">About Shannon</p>

      <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
        <!-- Her photograph, directly beneath the heading -->
        <div class="lg:col-span-5">
          <figure class="bloom mx-auto max-w-[26rem] lg:mx-0 lg:max-w-none">
            <img src="/brand/ink/portrait-violet.webp" alt="Shannon Suttles"
              width="1290" height="1313" class="w-full"
              loading="eager" fetchpriority="high" decoding="async" />
          </figure>
        </div>

        <div class="lg:col-span-6 lg:col-start-7 lg:pt-2">
          <h1 class="rise">
            <span class="display block text-pearl">A Life Restored</span>
            <span class="display gilt gilt-live block italic">and Given Back to God</span>
          </h1>
          <p class="label label-gold rise mt-7">
            President &amp; CEO · Firebrand Revivalists&trade;
          </p>
          <hr class="rule-fine rule-short rise my-8" />
          <p class="rise font-body text-[clamp(1.15rem,1rem+0.75vw,1.55rem)] leading-[1.8] text-lilac/85">
            Shannon Suttles is an ordained pastor, organisational leader, business strategist, and
            writer whose life and work have been shaped by restoration.
          </p>
          <p class="rise mt-6 font-body text-lede leading-[1.85] text-lavender/65">
            More than 17 years in full-time ministry. More than 20 years in leadership. She has
            served families, businesses, ministries, schools, and public institutions through
            seasons of crisis, transition, rebuilding, and restoration.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ THE OFFICES ═══ -->
  <section class="g-obsidian relative overflow-hidden">
    <img src="/brand/ink/droplet.webp" alt="" aria-hidden="true"
      class="ink-art ink-far drift drift-rev -right-[12%] top-[8%] w-[24rem] object-contain lg:w-[30rem]" />

    <div class="above mx-auto max-w-[96rem] px-7 py-20 sm:px-12 lg:px-20 lg:py-24">
      <p class="label label-gold rise mb-10">She Serves As</p>
      <ul class="stagger">
        {roles.map((role, i) => (
          <li class="rise grid items-baseline gap-2 border-t border-gold-lum/20 py-6 sm:grid-cols-12 sm:gap-8 lg:py-7"
            style={`--i:${i}`}>
            <p class="label label-gold sm:col-span-3">{role.title}</p>
            <p class="font-display text-[clamp(1.2rem,1rem+1vw,1.85rem)] leading-tight font-normal text-pearl sm:col-span-9">
              {role.org}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ BEFORE MINISTRY ═══ -->
  <section class="g-pearl relative overflow-hidden">
    <div class="mx-auto max-w-[96rem] px-7 py-20 sm:px-12 lg:px-20 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-3">
          <p class="label rise" style="color: var(--color-copper)">Before Ministry</p>
          <hr class="rule-ink rule-short rise mt-6" />
        </div>
        <div class="lg:col-span-8 lg:col-start-5">
          <p class="rise font-body text-[clamp(1.1rem,1rem+0.6vw,1.4rem)] leading-[1.8] text-graphite">
            Shannon worked extensively in property management and commercial leasing, leading
            operations for a Class A asset valued at approximately $400 million — overseeing large
            teams, administering multimillion-dollar contracts, and managing leasing, maintenance,
            security, budgets, and operational performance.
          </p>
          <p class="rise mt-6 font-body text-lede leading-[1.8]" style="color: var(--color-mauve)">
            That experience taught her to see beyond a visible problem and recognise what is
            happening underneath it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ THE LIFE BEHIND THE WORK ═══ -->
  <section class="g-obsidian relative overflow-hidden">
    <div class="above mx-auto max-w-[96rem] px-7 py-20 sm:px-12 lg:px-20 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="title rise text-pearl">
            The Life<br /><span class="text-gold-lum italic">Behind the Work</span>
          </h2>
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <div class="rise space-y-6 font-body text-lede leading-[1.85] text-lavender/75">
            <p>
              Shannon's early life was marked by severe abuse, rejection, instability,
              homelessness, the impact of addiction, and deep emotional wounds.
            </p>
            <p class="text-lilac italic">
              Before she knew how to rest, trust, or feel safe, she learned how to survive.
            </p>
            <p>
              As a teenager and young mother, Shannon was pressured to relinquish her daughter,
              Anne, for adoption. What appeared to be a permanent separation became a story of
              extraordinary restoration. Mother and daughter were reunited, their relationship was
              rebuilt, and Anne is now an integral part of the family, its businesses, and its
              ministry work.
            </p>
            <p>
              Shannon also endured an abusive marriage and the painful separation from her son.
              After years of perseverance through family court, he was restored to her care and
              was later adopted by Jason.
            </p>
            <p>
              These experiences gave Shannon a lasting conviction: that children deserve safe and
              loving families, that healthy restoration should be supported, and that no one
              should walk through overwhelming circumstances alone.
            </p>
            <p>
              Jesus did more than help Shannon survive. He restored her identity, rebuilt her
              capacity to love and trust, and transformed places of pain into places of hope for
              others.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PULL QUOTE ═══ -->
  <section class="g-depth relative overflow-hidden">
    <div class="above mx-auto max-w-4xl px-7 py-24 text-center sm:px-12 lg:py-32">
      <p class="rise font-display text-[clamp(1.5rem,1.1rem+2vw,2.75rem)] leading-[1.35] text-pearl">
        These experiences are not side notes to the work.
      </p>
      <p class="rise mt-4 font-display text-[clamp(1.5rem,1.1rem+2vw,2.75rem)] leading-[1.35] text-gold-lum italic"
        style="--delay:140ms">
        They explain why the work exists.
      </p>
    </div>
  </section>

  <!-- ═══ ONE CALLING ═══ -->
  <section class="g-pearl relative overflow-hidden">
    <div class="mx-auto max-w-[96rem] px-7 py-20 sm:px-12 lg:px-20 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-3">
          <p class="label rise" style="color: var(--color-copper)">One Calling</p>
        </div>
        <div class="lg:col-span-8 lg:col-start-5">
          <p class="rise font-body text-lede leading-[1.8]" style="color: var(--color-mauve)">
            Whether Shannon is writing poetry, praying with a family, supporting a school chaplain,
            advising an organisation, or helping create a place of restoration for weary leaders,
            the calling remains the same:
          </p>
          <p class="rise mt-8 font-display text-[clamp(1.35rem,1.05rem+1.4vw,2.2rem)] leading-[1.4] text-obsidian">
            To recognise what God is restoring, help bring it into order, and create room for
            others to become whole.
          </p>
          <div class="rise mt-10 flex flex-wrap gap-5">
            <a href="/poetry" class="btn-ink btn-ink-dark">Words &amp; Prayers</a>
            <a href="/work" class="btn-ink btn-ink-dark">Her Ventures</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
