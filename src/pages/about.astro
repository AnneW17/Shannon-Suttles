---
import BaseLayout from '@layouts/BaseLayout.astro';

const roles = [
  { title: 'President and CEO', org: 'Firebrand Revivalists' },
  { title: 'President', org: 'Jesus Loves the Little Children Chaplaincy' },
  { title: 'President', org: 'Ember Ridge' },
  { title: 'President', org: 'The Generational Legacy Foundation' },
  { title: 'President and Founder', org: 'Sophion Media & Consulting Group' },
  { title: 'National Leader', org: 'Nehemiah Alliance' },
];
---

<BaseLayout
  title="About"
  description="Shannon Suttles is an ordained pastor, organisational leader, business strategist, and writer whose life and work have been shaped by restoration."
>
  <!-- Opening.
       The new President portrait, shown square and whole — no crop. A gold
       ornament column runs the left margin: cut-stone facets, fine botanical
       linework and sparkle, drawn as vector so it stays crisp and weighs
       nothing. Roses bleed behind it. -->
  <section class="ground-blush relative overflow-hidden">

    <img src="/brand/art/ornament-column.svg" alt="" aria-hidden="true"
      class="botanical parallax parallax-slow -left-2 top-0 hidden h-full w-[8rem] opacity-90 xl:block 2xl:-left-4 2xl:w-[10rem]" />
    <img src="/brand/art/botanical-corner-left.webp" alt="" aria-hidden="true"
      class="botanical botanical-quiet parallax parallax-slow -left-24 -top-20 w-[22rem] lg:w-[32rem]" />
    <img src="/brand/art/rose-accent.webp" alt="" aria-hidden="true"
      class="botanical botanical-quiet parallax parallax-slow-r -right-20 bottom-0 w-[18rem] lg:w-[26rem]" />

    <div class="relative z-10 mx-auto max-w-[92rem] px-5 pt-14 pb-20 sm:px-8 lg:px-12 lg:pt-20 lg:pb-28">
      <p class="label label-gold reveal mb-8">About Shannon</p>

      <div class="ground-champagne-deep reveal relative mb-14 py-8 lg:py-10"
        style="margin-left:calc(50% - 50vw); margin-right:calc(50% - 50vw); padding-left:max(1.25rem,calc(50vw - 46rem + 1.25rem)); padding-right:max(1.25rem,calc(50vw - 46rem + 1.25rem));">
        <h1>
          <span class="mask-line">
            <span class="type-name type-fill-cream block font-display">A Life Restored</span>
          </span>
          <span class="mask-line">
            <span class="type-name type-fill-cream block pl-[6vw] font-display italic"
              style="transition-delay:140ms">and Given Back to God</span>
          </span>
        </h1>
      </div>

      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5">
          <figure class="veil-slow frame-offset relative mx-auto max-w-[26rem] lg:mx-0 lg:max-w-none">
            <img src="/brand/art/portrait-president.webp"
              alt="Shannon Suttles" width="1000" height="1000"
              class="block h-auto w-full" loading="eager" fetchpriority="high" decoding="async" />
          </figure>
          <p class="label reveal mt-5">Shannon Suttles · President &amp; CEO, Firebrand Revivalists</p>
        </div>

        <div class="lg:col-span-6 lg:col-start-7">
          <p class="reveal font-display text-[clamp(1.35rem,1.05rem+1.2vw,2.1rem)] leading-[1.45] font-light text-ink-800">
            Shannon Suttles is an ordained pastor, organisational leader, business strategist, and
            writer whose life and work have been shaped by restoration.
          </p>
          <hr class="rule-gold-solid reveal mt-8 w-24" />
        </div>
      </div>
    </div>
  </section>

  <!-- Lede + roles -->
  <section class="mx-auto max-w-[88rem] px-5 py-20 sm:px-8 lg:px-12">
    <hr class="rule-gold reveal mb-16" />

    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="prose-editorial reveal">
          <p>
            More than 17 years in full-time ministry. More than 20 years in leadership.
          </p>
          <p>
            She has served families, businesses, ministries, schools, and public institutions
            through seasons of crisis, transition, rebuilding, and restoration.
          </p>
        </div>
      </div>

      <!-- Roles as an editorial list, not a paragraph of commas. -->
      <div class="lg:col-span-4 lg:col-start-9">
        <h2 class="label mb-6">Roles</h2>
        <ul>
          {
            roles.map((role, i) => (
              <li class="reveal border-b border-champagne-200/70 py-4 first:border-t" style={`--delay: ${i * 80}ms`}>
                <p class="label label-gold">{role.title}</p>
                <p class="mt-1 font-display text-xl leading-snug font-light text-ink-800">
                  {role.org}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Before ministry -->
  <section class="border-y border-champagne-200 bg-cream-50">
    <div class="mx-auto max-w-[88rem] px-5 py-20 sm:px-8 lg:px-12">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-3">
          <h2 class="reveal label">Before Ministry</h2>
        </div>
        <div class="lg:col-span-7">
          <div class="prose-editorial reveal">
            <p>
              Shannon worked extensively in property management and commercial leasing, leading
              operations for a Class A asset valued at approximately $400 million — overseeing
              large teams, administering multimillion-dollar contracts, and managing leasing,
              maintenance, security, budgets, and operational performance.
            </p>
            <p>
              That experience taught her to see beyond a visible problem and recognise what is
              happening underneath it.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The life behind the work -->
  <section class="mx-auto max-w-[88rem] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <h2 class="reveal font-display text-display-sm leading-tight font-light text-ink-900">
          The Life<br /><span class="italic">Behind the Work</span>
        </h2>
      </div>

      <div class="lg:col-span-7">
        <div class="prose-editorial reveal">
          <p>
            Shannon's early life was marked by severe abuse, rejection, instability, homelessness,
            the impact of addiction, and deep emotional wounds.
          </p>
          <p>Before she knew how to rest, trust, or feel safe, she learned how to survive.</p>
          <p>
            As a teenager and young mother, Shannon was pressured to relinquish her daughter, Anne,
            for adoption. What appeared to be a permanent separation became a story of
            extraordinary restoration. Mother and daughter were reunited, their relationship was
            rebuilt, and Anne is now an integral part of the family, its businesses, and its
            ministry work.
          </p>
          <p>
            Shannon also endured an abusive marriage and the painful separation from her son. After
            years of perseverance through family court, he was restored to her care and was later
            adopted by Jason.
          </p>
          <p>
            These experiences gave Shannon a lasting conviction: that children deserve safe and
            loving families, that healthy restoration should be supported, and that no one should
            walk through overwhelming circumstances alone.
          </p>
          <p>
            Jesus did more than help Shannon survive. He restored her identity, rebuilt her
            capacity to love and trust, and transformed places of pain into places of hope for
            others.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pull quote -->
  <section class="bg-ink-900 text-cream-100">
    <div class="mx-auto max-w-4xl px-5 py-24 text-center sm:px-8 lg:py-32">
      <p
        class="reveal font-display text-[clamp(1.75rem,1.2rem+2.4vw,3.25rem)] leading-[1.35] font-light"
      >
        These experiences are not side notes to the work.
      </p>
      <p
        class="type-fill-cream reveal mt-3 font-display text-[clamp(1.75rem,1.2rem+2.4vw,3.25rem)] leading-[1.35] font-light italic"
        style="--delay: 140ms"
      >
        They explain why the work exists.
      </p>
    </div>
  </section>

  <!-- Closing -->
  <section class="mx-auto max-w-[88rem] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <h2 class="reveal label">One Calling, Expressed in Many Ways</h2>
      </div>
      <div class="lg:col-span-7">
        <p class="prose-editorial reveal">
          Whether Shannon is writing poetry, praying with a family, supporting a school chaplain,
          advising an organisation, or helping create a place of restoration for weary leaders, the
          calling remains the same:
        </p>
        <p
          class="reveal mt-8 font-display text-[clamp(1.5rem,1.15rem+1.5vw,2.25rem)] leading-[1.45] font-light text-ink-900"
        >
          To recognise what God is restoring, help bring it into order, and create room for others
          to become whole.
        </p>

        <div class="reveal mt-14 flex flex-wrap gap-x-10 gap-y-4">
          <a href="/poetry" class="label link-editorial text-ink-900">Read the Poetry</a>
          <a href="/work" class="label link-editorial">Explore Her Work</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
