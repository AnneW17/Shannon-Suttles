---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-5 py-24 text-center">
    <p class="label mb-8">404</p>
    <h1 class="font-display text-display-md leading-tight font-light text-ink-900">
      This page has <span class="italic">wandered off</span>
    </h1>
    <p class="prose-editorial mt-8">
      The page you are looking for is not here. It may have moved, or the link may be incomplete.
    </p>
    <div class="mt-12 flex flex-wrap justify-center gap-x-10 gap-y-4">
      <a href="/poetry" class="label link-editorial text-ink-900">Read the Poetry</a>
      <a href="/" class="label link-editorial">Return Home</a>
    </div>
  </section>
</BaseLayout>
