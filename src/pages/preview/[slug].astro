---
import BaseLayout from '@layouts/BaseLayout.astro';
import PoemBody from '@components/PoemBody.astro';
import Signature from '@components/Signature.astro';
import { getPoemPreview, getSiteSettings } from '@lib/sanity/queries';
import { imageUrl, hasImage } from '@lib/sanity/image';
import { formatDate, isoDate } from '@lib/format';

/**
 * DRAFT PREVIEW
 *
 * The one route in the site that is rendered on request rather than at build
 * time — it has to be, because it reads content that has not been published.
 *
 * Reached from the "Preview" link inside the Studio, so Shannon can see
 * exactly how a poem will look before anyone else can. Never indexed
 * (see netlify.toml) and never included in the sitemap.
 */
export const prerender = false;

const { slug } = Astro.params;
const poem = await getPoemPreview(slug!);
const settings = await getSiteSettings();
---

<BaseLayout title="Preview" noindex>
  <!-- An unmistakable banner, so a draft is never mistaken for the live page. -->
  <div class="sticky top-[73px] z-40 border-y border-gold-400 bg-gold-500/10 px-5 py-3">
    <div class="mx-auto flex max-w-[88rem] flex-wrap items-center justify-between gap-3">
      <p class="label" style="color: var(--color-gold-600)">
        Preview — this poem is not published yet
      </p>
      {poem && (
        <p class="font-ui text-sm text-ink-600">Only you can see this page.</p>
      )}
    </div>
  </div>

  {
    !poem ? (
      <div class="mx-auto max-w-2xl px-5 py-32 text-center">
        <h1 class="font-display text-display-sm font-light text-ink-900">
          Nothing to preview
        </h1>
        <p class="prose-editorial mx-auto mt-6">
          This poem could not be found as a draft. It may already be published, or the preview
          feature may not be set up yet.
        </p>
        <p class="mt-8">
          <a href="/poetry" class="label link-editorial text-ink-900">Go to Poetry</a>
        </p>
      </div>
    ) : (
      <article class="mx-auto max-w-[88rem] px-5 py-16 sm:px-8 lg:px-12">
        <div class="grid lg:grid-cols-12">
          <div class="lg:col-span-7 lg:col-start-3">
            <h1 class="font-display text-[clamp(2.25rem,1.3rem+3.6vw,4.75rem)] leading-[1.04] font-light text-ink-900">
              {poem.title}
            </h1>

            <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2">
              <time datetime={isoDate(poem.publishedAt)} class="label">
                {formatDate(poem.publishedAt)}
              </time>
              {poem.category && <span class="label label-gold">{poem.category.title}</span>}
            </div>

            {hasImage(poem.featureImage) && (
              <img
                src={imageUrl(poem.featureImage, 1200)}
                alt={poem.featureImage.alt || ''}
                class="mt-12 w-full object-cover"
                loading="eager"
                decoding="async"
              />
            )}

            <PoemBody body={poem.body} class="mt-12" />

            {poem.showSignature !== false && <Signature settings={settings} />}
          </div>
        </div>
      </article>
    )
  }
</BaseLayout>
