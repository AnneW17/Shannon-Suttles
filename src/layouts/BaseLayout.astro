---
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/jost';
import '../styles/global.css';

import SEO from '@components/SEO.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FAF6EF" />

    <link rel="icon" type="image/png" href="/brand/emblem.png" />
    <link rel="apple-touch-icon" href="/brand/emblem.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Sanity's CDN serves every poem image; warming the connection early
         removes a round trip from the largest contentful paint. -->
    <link rel="preconnect" href="https://cdn.sanity.io" />

    <SEO {...props} />

    <!-- Swap the no-js class before paint, so reveal animations are armed
         only when JavaScript is actually available. -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>

  <body class="min-h-screen antialiased">
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- Editorial motion.
         One IntersectionObserver for reveals, one throttled scroll listener
         for parallax. No animation library. Content is visible by default
         and revealed progressively, so a failure here can never hide a poem. -->
    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---------- reveals ---------- */
      const revealTargets = document.querySelectorAll('.reveal, .veil, .veil-slow, .mask-line');

      if (reduced || !('IntersectionObserver' in window)) {
        revealTargets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.06 }
        );
        revealTargets.forEach((el) => observer.observe(el));

        /* Safety net.
           IntersectionObserver samples once per frame. A fast flick — or a
           jump to an anchor — can carry an element past the viewport between
           samples, and it then stays hidden forever. This sweep reveals
           anything that is already at or above the fold, so a section can
           never be left blank. Runs on the same throttled scroll pass as the
           parallax below, so it costs nothing extra. */
        const sweep = () => {
          let remaining = 0;
          for (const el of revealTargets) {
            if (el.classList.contains('is-visible')) continue;
            if (el.getBoundingClientRect().top < window.innerHeight) {
              el.classList.add('is-visible');
              observer.unobserve(el);
            } else {
              remaining++;
            }
          }
          if (!remaining) window.removeEventListener('scroll', onSweep);
        };
        let sweeping = false;
        const onSweep = () => {
          if (sweeping) return;
          sweeping = true;
          requestAnimationFrame(() => { sweep(); sweeping = false; });
        };
        window.addEventListener('scroll', onSweep, { passive: true });
        window.addEventListener('resize', onSweep, { passive: true });
      }

      /* ---------- parallax ----------
         Each element gets its offset from its own distance to the viewport
         centre, so movement is relative to the element rather than to the
         top of the document. Values are small on purpose. */
      const parallaxItems = Array.from(document.querySelectorAll('.parallax'));

      if (!reduced && parallaxItems.length && window.matchMedia('(min-width: 640px)').matches) {
        let ticking = false;

        const update = () => {
          const mid = window.innerHeight / 2;
          for (const el of parallaxItems) {
            const rect = el.getBoundingClientRect();
            if (rect.bottom < -200 || rect.top > window.innerHeight + 200) continue;
            const offset = (rect.top + rect.height / 2 - mid) * 0.5;
            el.style.setProperty('--scroll-offset', offset.toFixed(1) + 'px');
          }
          ticking = false;
        };

        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };

        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
