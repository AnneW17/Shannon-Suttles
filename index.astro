---
import BaseLayout from '@layouts/BaseLayout.astro';
import PoemListItem from '@components/PoemListItem.astro';
import { getAllPoems } from '@lib/sanity/queries';

const poems = await getAllPoems();
const hasWork = poems.length > 0;
---

<BaseLayout
  title="Poetry"
  description="The poetry of Shannon Suttles — praises, remembrances, laments, acts of gratitude, and honest conversations with God."
>

  <section class="g-depth relative overflow-hidden">
    <img src="/brand/ink/quill.webp" alt="" aria-hidden="true"
      class="ink-art ink-far drift drift-slow -right-[16%] top-0 h-[88%] w-auto object-contain lg:-right-[4%]" />

    <div class="above mx-auto max-w-[96rem] px-7 pt-20 pb-20 sm:px-12 lg:px-20 lg:pt-24 lg:pb-24">
      <p class="label label-gold rise mb-9">Poetry</p>
      <h1 class="rise w-full">
        <span class="sr-only">Poetry to God</span>
        <img src="/brand/ink/poetry-to-god.webp" alt="Poetry to God"
          width="1920" height="640"
          class="w-full max-w-[44rem] object-contain"
          loading="eager" fetchpriority="high" decoding="async" />
      </h1>
      <div class="rise mt-10 max-w-lg" style="--delay:260ms">
        <p class="font-body text-lede leading-[1.85] text-lilac/80">
          These poems are praises, remembrances, laments, acts of gratitude, and honest
          conversations with God.
        </p>
        <hr class="rule-fine rule-short my-7" />
        <p class="font-body text-lede leading-[1.85] text-lavender/70 italic">
          This space is dedicated to Jesus. May every word become worship.
        </p>
      </div>
    </div>
  </section>

  {hasWork ? (
    <section class="g-pearl relative overflow-hidden">
      <div class="mx-auto max-w-[96rem] px-7 py-20 sm:px-12 lg:px-20 lg:py-28">
        {poems.map((poem, i) => <PoemListItem poem={poem} index={i} />)}
      </div>
    </section>
  ) : (
    <!-- Space held for the work, stated plainly. No invented titles,
         collections, categories or excerpts. -->
    <section class="g-obsidian relative overflow-hidden">
      <div class="plate plate-bleed bloom">
        <img src="/brand/ink/droplet.webp" alt="" aria-hidden="true"
          class="mx-auto max-w-[32rem] opacity-85" width="1254" height="1254"
          loading="lazy" decoding="async" />
      </div>
      <div class="above mx-auto -mt-16 max-w-2xl px-7 pb-24 text-center sm:px-12 lg:-mt-24 lg:pb-32">
        <p class="rise font-display text-[clamp(1.5rem,1.1rem+1.8vw,2.6rem)] leading-[1.4] text-pearl">
          The first poems are being written.
        </p>
        <p class="rise mx-auto mt-7 max-w-md font-body text-lede leading-[1.85] text-lavender/70" style="--delay:180ms">
          Her work will be published here as it is completed.
        </p>
      </div>
    </section>
  )}

</BaseLayout>
