---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@lib/site';
---

<BaseLayout title="Privacy" description="Privacy policy." noindex>
  <section class="mx-auto max-w-[88rem] px-5 pt-16 pb-24 sm:px-8 lg:px-12 lg:pt-24">
    <div class="grid lg:grid-cols-12">
      <div class="lg:col-span-7 lg:col-start-3">
        <p class="label mb-7">Legal</p>
        <h1 class="font-display text-display-md leading-tight font-light text-ink-900">
          Privacy Policy
        </h1>

        <div class="mt-10 border border-gold-400/50 bg-gold-500/5 p-6">
          <p class="label label-gold mb-2">Placeholder — needs real content</p>
          <p class="prose-editorial text-base">
            This page needs a privacy policy written or reviewed by someone qualified to do so.
            The notes below describe what this website actually does, which is the information a
            lawyer or policy generator will ask for. Nothing here is legal advice.
          </p>
        </div>

        <div class="prose-editorial mt-12">
          <h2 class="mt-10 font-display text-2xl font-light text-ink-900">
            What this site actually collects
          </h2>
          <p>
            As built, this website does not collect personal information. There is no contact
            form, no account system, no newsletter signup, no advertising, and no analytics or
            tracking scripts.
          </p>
          <p>
            Images and poem content are delivered from Sanity's content network (cdn.sanity.io).
            The site is hosted on Netlify, which keeps standard server access logs.
          </p>
          <p>
            Emailing <a href={`mailto:${SITE.email}`} class="link-editorial">{SITE.email}</a>
            {' '}means corresponding directly with the team; those messages live in that mailbox
            like any other email.
          </p>

          <h2 class="mt-10 font-display text-2xl font-light text-ink-900">Cookies</h2>
          <p>
            This site sets no cookies of its own and uses no tracking cookies, which is why no
            cookie banner appears. If analytics or a newsletter signup are added later, this
            section and the banner requirement must both be revisited.
          </p>

          <h2 class="mt-10 font-display text-2xl font-light text-ink-900">Giving</h2>
          <p>
            Contributions are handled entirely by PayPal, Venmo, Cash App, Givelify, or Zelle.
            Those services collect and process payment information under their own privacy
            policies. This website never receives, stores, or has access to payment details.
          </p>

          <h2 class="mt-10 font-display text-2xl font-light text-ink-900">Contact</h2>
          <p>
            Questions about privacy can be sent to
            <a href={`mailto:${SITE.email}`} class="link-editorial">{SITE.email}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
