# ---------------------------------------------------------------
# Shannon Suttles — environment variables
#
# Copy this file to `.env` and fill in the real values.
# NEVER commit the real `.env` file. It is already in .gitignore.
# ---------------------------------------------------------------

# --- Sanity (required) -----------------------------------------
# Found in your Sanity project settings, or printed in the terminal
# when you first run `npm create sanity@latest`.
PUBLIC_SANITY_PROJECT_ID="your_project_id_here"

# Almost always "production". Leave as-is unless you were told otherwise.
PUBLIC_SANITY_DATASET="production"

# Sanity API version. Pinned to a date so future Sanity changes
# can never silently alter how the site behaves.
PUBLIC_SANITY_API_VERSION="2024-10-01"

# --- Sanity draft preview (optional) ---------------------------
# A READ-ONLY token, used only to display unpublished drafts on the
# private /preview/ route. Server-side only — never sent to browsers.
# Create at: sanity.io/manage -> API -> Tokens -> "Viewer" permission.
# Leave blank to disable preview entirely; the public site is unaffected.
SANITY_VIEWER_TOKEN=""

# --- Site (required) -------------------------------------------
# Used for canonical URLs, the sitemap, and social share images.
# No trailing slash.
PUBLIC_SITE_URL="https://shannonsuttles.com"
